{
  "name": "bidi-browser-mcp",
  "version": "0.1.0",
  "description": "WebDriver BiDi browser MCP server — control your real Firefox over the W3C standard protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bidi-browser-mcp": "dist/index.js"
  },
  "author": "Tushar Agarwal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tushar49/bidi-browser-mcp.git"
  },
  "homepage": "https://github.com/Tushar49/bidi-browser-mcp#readme",
  "bugs": {
    "url": "https://github.com/Tushar49/bidi-browser-mcp/issues"
  },
  "files": [
    "dist/**"
  ],
  "keywords": [
    "mcp",
    "automation",
    "bidi",
    "webdriver-bidi",
    "firefox",
    "browser-automation",
    "model-context-protocol",
    "ai-agent",
    "browser-mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "benchmark": "vitest run --config vitest.benchmark.config.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
